#!/bin/sh
set -eu

red=$(printf '\033[1;31m')
grn=$(printf '\033[1;32m')
end=$(printf '\033[0m')

account=${STAGING_ACCOUNT:-training-staging}
repo=${1:-}
if [ -z "$repo" ]; then
  printf '%s\n' "Uso: $0 <repositorio-de-staging>" >&2
  printf '%s\n' "O destino não pode ser inferido com segurança; nenhum push foi executado." >&2
  exit 64
fi
case "$repo" in
  *[!A-Za-z0-9._-]*)
    printf '%s\n' "Nome de repositório de staging inválido." >&2
    exit 64
    ;;
esac

remote_url=${STAGING_REMOTE_URL:-https://ghe.io/${account}/${repo}.git}
site_url=${STAGING_SITE_URL:-https://pages.ghe.io/${account}/${repo}/}

# Nunca reutilizar um _site antigo depois de uma falha de build.
rm -rf _site
printf "\n%s# Building site...%s\n--------------------------------------------------\n" "$grn" "$end"
DISABLE_WHITELIST=1 bundle exec jekyll build --baseurl "/${account}/${repo}"

printf "\n%s# Creating a temp Git repo...%s\n--------------------------------------------------\n" "$grn" "$end"
cd _site
git init -q
git checkout -q -b master
git remote add staging "$remote_url"
git add .
git commit -q -m "Staging latest changes"

printf "\n%s# Publishing...%s\n--------------------------------------------------\n" "$grn" "$end"
# O push é deliberadamente não-forçado. Divergência remota deve bloquear o staging.
git push staging master:gh-pages
git remote remove staging

printf "\n%s# Success!%s\n" "$grn" "$end"
if command -v open >/dev/null 2>&1; then
  open "$site_url"
else
  printf 'Staging publicado em %s\n' "$site_url"
fi
